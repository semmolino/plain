# ── Owner-Konsole — Umgebungsvariablen ───────────────────────────────────────
# Eigener, von der Tenant-App UNABHÄNGIGER Satz Geheimnisse.

# Eigenes Secret (NICHT das JWT_SECRET der Tenant-App wiederverwenden!)
CONSOLE_JWT_SECRET=change-me-to-a-long-random-string

# Dieselbe Supabase-Datenbank wie die Hauptanwendung (Control-Plane verwaltet
# die globalen Lizenz-Tabellen -> Service-Key ist hier angemessen).
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_SERVICE_KEY=<service-role-key>

# Port + erlaubte Origin(s) der Konsolen-UI (kommagetrennt).
CONSOLE_PORT=4000
CONSOLE_ORIGINS=http://localhost:4173

# NODE_ENV=production aktiviert HSTS-strikt + deaktiviert localhost-CORS.
NODE_ENV=development

# ── Jira-Übergabe (Vorschläge → Roadmap, optional) ───────────────────────────
# Ohne diese Variablen ist der Button „Als Jira-Ticket anlegen" inaktiv (klare
# Fehlermeldung). REST API v2, Basic-Auth mit E-Mail + API-Token.
JIRA_BASE_URL=https://<dein-raum>.atlassian.net
JIRA_EMAIL=<atlassian-konto-email>
JIRA_API_TOKEN=<api-token>
JIRA_PROJECT_KEY=<z.B. ROAD>
JIRA_ISSUE_TYPE=Task

# ── E-Mail-Benachrichtigung an Anwender (Eusend/SMTP, optional) ──────────────
# Wird nur gesendet, wenn SMTP_HOST + SMTP_FROM gesetzt sind; sonst still
# übersprungen (no-op). Dieselben Werte wie in der Tenant-App verwenden.
# HINWEIS: unabhängig von PLATFORM_EMAIL_SETTINGS unten — dies ist der eigene
# Best-Effort-Versand der Owner-Konsole (services/notify.js), keine
# Tenant-Mails.
SMTP_HOST=smtp.eusend.dev
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=<eusend-smtp-user>
SMTP_PASS=<eusend-smtp-passwort>
SMTP_FROM=plan&simple <noreply@deine-domain.de>

# ── Zentrale Plattform-SMTP-Konfiguration (E-Mail-Tab der Konsole) ───────────
# 32-Byte Base64-Schluessel zum Ver-/Entschluesseln des SMTP-Passworts, das
# hier im "E-Mail"-Tab fuer den globalen Mailversand der Tenant-App gespeichert
# wird (PLATFORM_EMAIL_SETTINGS, AES-256-GCM). MUSS identisch mit dem Wert in
# backend/.env sein — sonst kann das Backend das Passwort nicht entschluesseln.
# Erzeugen mit: openssl rand -base64 32
PLATFORM_ENC_KEY=<32-byte-base64-key>
