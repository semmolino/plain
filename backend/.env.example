# Copy this file to .env and fill in your values
# NEVER commit .env to git

SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_KEY=your-service-role-key-here
SUPABASE_ANON_KEY=your-anon-key-here
PORT=3000

# Direct Postgres connection for migrations (Supabase: Settings → Database → Connection string → URI)
DATABASE_URL=postgresql://postgres:[password]@db.[project-ref].supabase.co:5432/postgres

# ── E-Mail-Versand (SMTP, z.B. Eusend) ───────────────────────────────────────
# Bevorzugt wird die zentrale SMTP-Konfiguration aus der Owner-Konsole
# (PLATFORM_EMAIL_SETTINGS, Migration 0112, verschluesselt via PLATFORM_ENC_KEY
# unten). Die Variablen hier sind nur der ENV-Fallback, falls dort nichts
# hinterlegt ist. Mandanten koennen in den E-Mail-Einstellungen ausserdem nur
# ihre Absenderadresse/Anzeigename/Reply-To ueberschreiben, siehe
# backend/services/emailSettingsService.js. Ohne SMTP-Konfiguration (weder DB
# noch ENV) ist kein Mailversand moeglich — Passwort-Reset-Links landen dann
# nur im Server-Log.
SMTP_HOST=smtp.eusend.dev
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-eusend-smtp-user
SMTP_PASS=your-eusend-smtp-password
SMTP_FROM=plan&simple <noreply@deine-domain.de>

# 32-Byte Base64-Schluessel zum Entschluesseln des in der Owner-Konsole
# gespeicherten SMTP-Passworts (AES-256-GCM). MUSS identisch mit dem Wert in
# owner-console/.env sein. Erzeugen mit: openssl rand -base64 32
PLATFORM_ENC_KEY=your-32-byte-base64-key
