stify-content: flex-end !important; } </style></head><body><div class="page"><div class="logo-area"></div><div class="sender-line"> Musterplanung GmbH &middot; Beispielstraße 1 &middot; 10115 Berlin </div><div class="letter-header"><div class="address-col"><div class="address-block"><div class="name1">Bauherr Beispiel AG</div><div>z. Hd. Frau Kerstin Ludwig</div><div>Musterallee 7</div><div>80331 München</div></div></div><div class="meta-col"><table class="meta-table"><tr><td class="ml">Kontakt</td><td class="mv">Dipl.-Ing. Anna Muster</td></tr><tr><td class="ml">Telefon</td><td class="mv">030 1234567</td></tr><tr><td class="ml">E-Mail</td><td class="mv">info@musterplanung.de</td></tr><tr><td class="meta-sep" colspan="2"></td></tr><tr><td class="ml">Datum</td><td class="mv">30.09.2026</td></tr><tr><td class="ml">Rechnungs-Nr.</td><td class="mv bold">SR-2026-0007</td></tr><tr><td class="ml">Zahlungsziel</td><td class="mv">30.10.2026</td></tr></table></div></div><div class="ref-block"><div class="rf"><span class="rl">Ihre Zeichen:</span><span>04011000-12345-34</span></div><div class="rf"><span class="rl">Bauvorhaben:</span><span>Verwaltungszentrum Nord</span></div><div class="rf"><span class="rl">Projekt:</span><span>P-2026-014 – Neubau Verwaltungsgebäude Nord</span></div><div class="rf"><span class="rl">Auftrag:</span><span>V-2026-003 – Generalplanervertrag</span></div><div class="rf"><span class="rl">Leistungszeitraum:</span><span>01.09.2026–30.09.2026</span></div></div><div class="doc-title">Teilschlussrechnung</div><div class="salutation">Sehr geehrte Frau Ludwig,</div><div class="text-block">vereinbarungsgemäß berechnen wir Ihnen unsere Leistungen für den Leistungszeitraum 01.09.2026–30.09.2026.</div><table class="calc-table"><tr><td class="label">erbrachtes Honorar</td><td class="amount">63.000,00 €</td></tr><tr><td class="label">zzgl. Nebenkosten</td><td class="amount">3.300,00 €</td></tr><tr class="sep"><td class="line-cell"></td><td class="line-cell"></td></t