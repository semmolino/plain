-size: 9pt; color: #6b7280; margin-bottom: 3mm; } /* Generic appendix table */ .data-table { width: 100%; border-collapse: collapse; font-size: 9pt; } .data-table th { text-align: left; font-weight: 600; color: #374151; border-bottom: 0.5pt solid #9ca3af; padding: 1.5mm 2mm 1.5mm 0; } .data-table th.r, .data-table td.r { text-align: right; padding-left: 3mm; } .data-table td { padding: 1.5mm 2mm 1.5mm 0; border-bottom: 0.3pt solid #e5e7eb; vertical-align: top; } .data-table tr.sum-row td { font-weight: 700; border-top: 0.5pt solid #9ca3af; border-bottom: none; padding-top: 2mm; } /* Gruppierung nach Projektelement im Leistungsnachweis */ .data-table tr.group-row { break-after: avoid; } .data-table tr.group-row td { font-weight: 700; color: #111827; background: #f3f4f6; border-top: 0.8pt solid #9ca3af; border-bottom: 0.4pt solid #cbd5e1; padding: 2.2mm 2mm; } .data-table tbody tr.group-row:first-child td { border-top: none; } .data-table tr.subtotal-row td { font-weight: 600; color: #374151; border-top: 0.5pt solid #9ca3af; border-bottom: none; padding-top: 1.5mm; padding-bottom: 2.5mm; } .data-table .muted { color: #6b7280; font-size: 8.5pt; } .data-table .bold { font-weight: 600; } /* Footer is rendered by Playwright footerTemplate from __footerCols data */ body { padding-bottom: 4mm; } /* ── HOAI appendix – shared with honorar.njk ────────────── */ .basis-grid { display: grid; grid-template-columns: repeat(3,1fr); gap:3mm; margin-bottom:2mm; page-break-inside: avoid; } .basis-cell { padding:2mm 3mm; background:#f9fafb; border:0.3pt solid #e5e7eb; border-radius:2pt; } .basis-cell .bc-label { font-size:7.5pt; color:#6b7280; margin-bottom:0.5mm; } .basis-cell .bc-val { font-size:9.5pt; font-weight:600; } .section-title-h { font-size:9pt; font-weight:700; color:#374151; text-transform:uppercase; letter-spacing:0.03em; margin:6mm 0 2mm; padding-bottom:1mm; border-bottom:0.5pt solid #d1d5db; page-break-after: avoid; } .surcharge-detail { font-size:7.5pt; color:#6b7280; 