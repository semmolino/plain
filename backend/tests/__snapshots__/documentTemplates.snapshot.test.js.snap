exports[`Belegvorlagen — Ausgabe mit den Beispielbelegen mahnung 1`] = `"<!doctype html><html lang="de"><head><meta charset="utf-8"><style> * { box-sizing: border-box; margin: 0; padding: 0; } body { font-family: Arial, Helvetica, sans-serif; font-size: 10pt; color: #1a1a1a; line-height: 1.4; padding-bottom: 4mm; } .logo-area { display: flex; justify-content: flex-end; margin-bottom: 6mm; min-height: 4mm; } .logo-area img { max-height: 20mm; max-width: 70mm; object-fit: contain; } .sender-line { font-size: 7.5pt; color: #6b7280; border-bottom: 0.3pt solid #d1d5db; padding-bottom: 1mm; margin-bottom: 5mm; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; } .letter-header { display: flex; gap: 10mm; margin-bottom: 8mm; align-items: flex-start; } .address-col { width: 85mm; flex-shrink: 0; } .address-block { font-size: 10pt; line-height: 1.5; min-height: 35mm; } .address-block .name1 { font-weight: 600; } .meta-col { flex: 1; } .meta-table { width: 100%; border-collapse: collapse; font-size: 9pt; } .meta-table td { padding: 0.8mm 0; vertical-align: top; } .meta-table td.ml { color: #6b7280; width: 32mm; padding-right: 2mm; } .meta-table td.mv { font-weight: 500; } .meta-table td.mv.bold { font-weight: 700; } .meta-sep { border-top: 0.3pt solid #d1d5db; padding-top: 1.5mm; height: 3mm; } .doc-title { font-size: 14pt; font-weight: 700; margin-bottom: 5mm; color: #111827; } .text-block { font-size: 10pt; margin-bottom: 5mm; white-space: pre-line; line-height: 1.5; } /* Betreff line */ .subject-line { font-size: 10pt; font-weight: 600; margin-bottom: 5mm; } .subject-line .subject-ref { font-weight: 400; } /* Invoice detail table */ .inv-table { width: 100%; border-collapse: collapse; margin: 4mm 0 6mm 0; } .inv-table th { text-align: left; font-weight: 600; font-size: 9pt; color: #374151; border-bottom: 0.5pt solid #9ca3af; padding: 1.5mm 2mm 1.5mm 0; } .inv-table th.r, .inv-table td.r { text-align: right; padding-left: 3mm; } .inv-table td { padding: 1.5mm 2mm 1.5mm 0; border-bottom: 0.3pt solid #e5e7eb; font-size: 9.5pt; } /* Totals section */ .totals-table { width: 100%; border-collapse: collapse; margin: 4mm 0; } .totals-table td { padding: 1.5mm 0; font-size: 10pt; } .totals-table td.lbl { color: #374151; } .totals-table td.amt { text-align: right; font-variant-numeric: tabular-nums; white-space: nowrap; padding-left: 6mm; } .totals-table tr.fee-row td { font-size: 9.5pt; color: #6b7280; } .totals-table tr.sep td { padding: 0; height: 2mm; } .totals-table tr.sep td.line { border-top: 0.5pt solid #9ca3af; } .totals-table tr.total-row td { font-weight: 700; font-size: 11pt; border-top: 1pt solid #1a1a1a; padding-top: 2mm; } /* Anrede und Zahlungshinweis (wie in der Rechnung) */ .salutation { font-size: 10pt; margin-bottom: 3mm; line-height: 1.5; } .payment-note-row { display: flex; align-items: flex-start; gap: 6mm; margin: 2mm 0 5mm; page-break-inside: avoid; } .payment-note-text { flex: 1; } .payment-note { font-size: 9.5pt; color: #374151; line-height: 1.5; } .payment-note strong { color: #1a1a1a; } .payment-qr { flex: 0 0 auto; display: flex; flex-direction: column; align-items: center; } .payment-qr img { width: 28mm; height: 28mm; display: block; } .payment-qr-caption { font-size: 7pt; color: #6b7280; margin-top: 1mm; text-align: center; } /* Footer is rendered by Playwright footerTemplate */ </style><style> :root{ --brand-accent:#111827; --brand-font:Arial, Helvetica, sans-serif; } body{ font-family: var(--brand-font) !important; } .doc-title, .metaBlock .title{ color: var(--brand-accent) !important; } .logo-area{ justify-content: flex-end !important; } </style></head><body><div class="logo-area"></div><div class="sender-line"> Musterplanung GmbH &middot; Beispielstraße 1 &middot; 10115 Berlin </div><div class="letter-header"><div class="address-col"><div class="address-block"><div class="name1">Bauherr Beispiel AG</div><div>z. Hd. Frau Kerstin Ludwig</div><div>Musterallee 7</div><div>80331 München</div></div></div><div class="meta-col"><table class="meta-table"><tr><td class="ml">Kontakt</td><td class="mv">Dipl.-Ing. Anna Muster</td></tr><tr><td class="ml">Telefon</td><td class="mv">030 1234567</td></tr><tr><td class="ml">E-Mail</td><td class="mv">info@musterplanung.de</td></tr><tr><td class="meta-sep" colspan="2"></td></tr><tr><td class="ml">Datum</td><td class="mv">13.11.2026</td></tr><tr><td class="ml">Rechnungs-Nr.</td><td class="mv bold">RE-2026-0042</td></tr><tr><td class="ml">Zahlungsziel war</td><td class="mv">30.10.2026</td></tr></table></div></div><div class="doc-title">1. Mahnung</div><div class="subject-line">Betreff: 1. Mahnung zu Rechnung RE-2026-0042<br><span class="subject-ref">Bauvorhaben: Verwaltungszentrum Nord</span></div><div class="text-block">leider konnten wir bis heute keinen Zahlungseingang zu der unten genannten Rechnung feststellen.</div><table class="inv-table"><thead><tr><th>Rechnungsnr.</th><th>Rechnungsdatum</th><th class="r">Rechnungsbetrag</th><th>Zahlungsziel</th><th class="r">Tage überfällig</th></tr></thead><tbody><tr><td>RE-2026-0042</td><td>30.09.2026</td><td class="r">22.015,00 €</td><td>30.10.2026</td><td class="r">14</td></tr></tbody></table><table class="totals-table"><tbody><tr><td class="lbl">Rechnungsbetrag</td><td class="amt">22.015,00 €</td></tr><tr><td class="lbl">abzgl. bereits eingegangener Zahlungen</td><td class="amt">&minus;&#8239;10.000,00 €</td></tr><tr class="sep"><td class="line" colspan="2"></td></tr><tr><td class="lbl">Offener Betrag</td><td class="amt">12.015,00 €</td></tr><tr class="fee-row"><td class="lbl">Mahnkostenpauschale (1. Mahnung)</td><td class="amt">5,00 €</td></tr><tr class="sep"><td class="line" colspan="2"></td></tr><tr class="total-row"><td class="lbl">Gesamtbetrag jetzt fällig</td><td class="amt">12.020,00 €</td></tr></tbody></table><div class="payment-note-row"><div class="payment-note-text"><div class="payment-note"> Bitte überweisen Sie <strong>12.020,00 €</strong> unter Angabe der Rechnungs