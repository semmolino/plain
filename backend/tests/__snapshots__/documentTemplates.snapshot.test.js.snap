t-size: 9pt; color: #6b7280; margin-bottom: 3mm; } /* Generic appendix table */ .data-table { width: 100%; border-collapse: collapse; font-size: 9pt; } .data-table th { text-align: left; font-weight: 600; color: #374151; border-bottom: 0.5pt solid #9ca3af; padding: 1.5mm 2mm 1.5mm 0; } .data-table th.r, .data-table td.r { text-align: right; padding-left: 3mm; } .data-table td { padding: 1.5mm 2mm 1.5mm 0; border-bottom: 0.3pt solid #e5e7eb; vertical-align: top; } .data-table tr.sum-row td { font-weight: 700; border-top: 0.5pt solid #9ca3af; border-bottom: none; padding-top: 2mm; } /* Gruppierung nach Projektelement im Leistungsnachweis */ .data-table tr.group-row { break-after: avoid; } .data-table tr.group-row td { font-weight: 700; color: #111827; background: #f3f4f6; border-top: 0.8pt solid #9ca3af; border-bottom: 0.4pt solid #cbd5e1; padding: 2.2mm 2mm; } .data-table tbody tr.group-row:first-child td { border-top: none; } .data-table tr.subtotal-row td { font-weight: 600; color: #374151; border-top: 0.5pt solid #9ca3af; border-bottom: none; padding-top: 1.5mm; padding-bottom: 2.5mm; } .data-table .muted { color: #6b7280; font-size: 8.5pt; } .data-table .bold { font-weight: 600; } /* Footer is rendered by Playwright footerTemplate from __footerCols data */ body { padding-bottom: 4mm; } /* ── HOAI appendix – shared with honorar.njk ────────────── */ .basis-grid { display: grid; grid-template-columns: repeat(3,1fr); gap:3mm; margin-bottom:2mm; page-break-inside: avoid; } .basis-cell { padding:2mm 3mm; background:#f9fafb; border:0.3pt solid #e5e7eb; border-radius:2pt; } .basis-cell .bc-label { font-size:7.5pt; color:#6b7280; margin-bottom:0.5mm; } .basis-cell .bc-val { font-size:9.5pt; font-weight:600; } .section-title-h { font-size:9pt; font-weight:700; color:#374151; text-transform:uppercase; letter-spacing:0.03em; margin:6mm 0 2mm; padding-bottom:1mm; border-bottom:0.5pt solid #d1d5db; page-break-after: avoid; } .surcharge-detail { font-size:7.5pt; color:#6b7280; margin-top:0.5mm; } .breakdown-row td { background:#fafafa; border-bottom:0.3pt solid #e5e7eb; padding:1mm 2mm 1.5mm 8mm; } .breakdown-table { width:100%; border-collapse:collapse; font-size:7.5pt; } .breakdown-table th { font-size:6.5pt; color:#9ca3af; font-weight:600; padding:0 1mm 0.5mm; text-align:right; } .breakdown-table th:first-child { text-align:left; } .breakdown-table td { padding:0.4mm 1mm; } .breakdown-table td.bd-num { text-align:right; white-space:nowrap; width:22%; } .breakdown-table tr.bd-lph td, .breakdown-table tr.bd-bl td { color:#374151; } .surcharge-mode-badge { display:inline-block; font-size:6.5pt; padding:0 2mm; border-radius:2pt; background:#e0f2fe; color:#0369a1; font-weight:600; margin-left:1mm; vertical-align:middle; } .honorar-summary { margin-top:8mm; padding:4mm 5mm; background:#f0f9ff; border:0.5pt solid #bae6fd; border-radius:3pt; page-break-inside: avoid; } .honorar-summary table { width:100%; border-collapse:collapse; } .honorar-summary td { padding:1.2mm 0; font-size:9.5pt; } .honorar-summary td.sl { color:#374151; } .honorar-summary td.sv { text-align:right; font-weight:600; white-space:nowrap; } .honorar-summary tr.gesamthonorar td { font-size:12pt; font-weight:700; border-top:1pt solid #0284c7; padding-top:2mm; } table.data-table tfoot td { border-top:1pt solid #374151; border-bottom:none; font-weight:600; padding-top:2mm; } table.data-table tfoot tr.grand-total td { font-size:11pt; font-weight:700; color:#111827; padding-top:2mm; } table.data-table td.num { text-align:right; white-space:nowrap; } table.data-table th.num { text-align:right; } table.data-table { page-break-inside: auto; } table.data-table tbody tr { page-break-inside: avoid; } table.data-table thead { display: table-header-group; } </style><style> :root{ --brand-accent:#111827; --brand-font:Arial, Helvetica, sans-serif; } body{ font-family: var(--brand-font) !important; } .doc-title, .metaBlock .title{ color: var(--brand-accent) !important; } .logo-area{ justify-content: flex-end !important; } </style></head><body><div class="page"><div class="logo-area"></div><div class="sender-line"> Musterplanung GmbH &middot; Beispielstraße 1 &middot; 10115 Berlin </div><div class="letter-header"><div class="address-col"><div class="address-block"><div class="name1">Bauherr Beispiel AG</div><div>z. Hd. Frau Kerstin Ludwig</div><div>Musterallee 7</div><div>80331 München</div></div></div><div class="meta-col"><table class="meta-table"><tr><td class="ml">Kontakt</td><td class="mv">Dipl.-Ing. Anna Muster</td></tr><tr><td class="ml">Telefon</td><td class="mv">030 1234567</td></tr><tr><td class="ml">E-Mail</td><td class="mv">info@musterplanung.de</td></tr><tr><td class="meta-sep" colspan="2"></td></tr><tr><td class="ml">Datum</td><td class="mv">30.09.2026</td></tr><tr><td class="ml">Rechnungs-Nr.</td><td class="mv bold">RE-2026-0042</td></tr><tr><td class="ml">Zahlungsziel</td><td class="mv">30.10.2026</td></tr></table></div></div><div class="ref-block"><div class="rf"><span class="rl">Ihre Zeichen:</span><span>04011000-12345-34</span></div><div class="rf"><span class="rl">Bauvorhaben:</span><span>Verwaltungszentrum Nord</span></div><div class="rf"><span class="rl">Projekt:</span><span>P-2026-014 – Neubau Verwaltungsgebäude Nord</span></div><div class="rf"><span class="rl">Auftrag:</span><span>V-2026-003 – Generalplanervertrag</span></div><div class="rf"><span class="rl">Leistungszeitraum:</span><span>01.09.2026–30.09.2026</span></div></div><div class="doc-title">Rechnung</div><div class="salutation">Sehr geehrte Frau Ludwig,</div><div class="text-block">vereinbarungsgemäß berechnen wir Ihnen unsere Leistungen für den Leistungszeitraum 01.09.2026–30.09.2026.</div><div class="text-block">Nebenleistung Brandschutz gemäß Beauftragung vom 12.08.2026</div><table class="calc-table"><tr><td class="label">erbrachtes Honorar</td><td class="amount">17.500,00 €</td></tr><tr><td class="label">zzgl. Nebenkosten</td><td class="amount">1.000,00 €</td></tr><tr class="sep"><td class="line-cell"></td><td class="line-cell"></td></tr><tr><td class="label">zzgl. 19&#8239;% Mehrwertsteuer</td><td class="amount">3.515,00 €</td></tr><tr class="total-row"><td class="label">Rechnungssumme</td><td class="amount">22.015,00 €</td></tr></table><div class="payment-note-row"><div class="payment-note-text"><div class="payment-note"> Bitte überweisen Sie <strong>22.015,00 €</strong> unter Angabe der Rechnungsnummer <strong>RE-2026-0042</strong> bis zum <strong>30.10.2026</strong> auf folgendes Konto:<br> IBAN: <strong>DE02 1203 0000 0000 2020 51</strong> &nbsp;&middot;&nbsp; BIC: <strong>BYLADEM1001</strong></div><div class="payment-note" style="margin-top:6px;"> Bei Zahlung innerhalb von <strong>14&#8239;Tagen</strong> gewähren wir <strong>2&#8239;% Skonto</strong> — Sie können in diesem Fall <strong>21.574,70 €</strong> überweisen. </div></div></div></div><div class="page"><div class="appendix-header"></div><div class="appendix-title">Zahlungsübersicht</div><div class="appendix-subtitle">Projekt: P-2026-014 – Neubau Verwaltungsgebäude Nord &middot; Stand: 30.09.2026</div><table class="data-table"><thead><tr><th>Abschlags-Nr.</th><th>Datum</th><th class="r">Netto</th><th class="r">MwSt.</th><th class="r">Brutto</th></tr></thead><tbody><tr><td>AR-2026-0011</td><td style="white-space:nowrap;">29.05.2026</td><td class="r">21.000,00 €</td><td class="r">3.990,00 €</td><td class="r">24.990,00 €</td></tr><tr><td>AR-2026-0019</td><td style="white-space:nowrap;">31.07.2026</td><td class="r">21.000,00 €</td><td class="r">3.990,00 €</td><td class="r">24.990,00 €</td></tr><tr style="font-weight:600;"><td>RE-2026-0042 &#x25C6;</td><td style="white-space:nowrap;">30.09.2026</td><td class="r">18.500,00 €</td><td class="r">3.515,00 €</td><td class="r">22.015,00 €</td></tr><tr class="sum-row"><td colspan="2">Summe</td><td class="r">60.500,00 €</td><td class="r">11.495,00 €</td><td class="r">71.995,00 €</td></tr></tbody></table></div><div class="page"><div class="appendix-header"></div><div class="appendix-title">Leistungsstandsübersicht / Honorarberechnung</div><div class="appendix-subtitle">P-2026-014 – Neubau Verwaltungsgebäude Nord &middot; V-2026-003 – Generalplanervertrag &middot; Stand: 30.09.2026</div><table class="data-table"><thead><tr><th>Leistungsphase</th><th class="r">Auftragswert</th><th class="r">Abgerechnet bis dato</th><th class="r">Diese Rechnung</th><th class="r">% erbracht</th></tr></thead><tbody><tr style="background:rgba(17,24,39,0.04); font-weight:600;"><td style="padding-left:2mm"><div class="bold">Gebäude</div><div class="muted">Objektplanung Gebäude</div></td><td class="r">120.000,00 €</td><td class="r">42.000,00 €</td><td class="r">18.500,00 €</td><td class="r">50&#8239;%</td></tr><tr><td style="padding-left:6mm"><div class="bold" style="font-weight:500">LP2</div><div class="muted">Vorplanung</div></td><td class="r">10.800,00 €</td><td class="r">10.800,00 €</td><td class="r">0,00 €</td><td class="r">100&#8239;%</td></tr><tr><td style="padding-left:6mm"><div class="bold" style="font-weight:500">LP3</div><div class="muted">Entwurfsplanung</div></td><td class="r">18.000,00 €</td><td class="r">9.000,00 €</td><td class="r">9.000,00 €</td><td class="r">100&#8239;%</td></tr><tr><td style="padding-left:6mm"><div class="bold" style="font-weight:500">LP5</div><div class="muted">Ausführungsplanung</div></td><td class="r">37.500,00 €</td><td class="r">22.200,00 €</td><td class="r">9.500,00 €</td><td class="r">85&#8239;%</td></tr><tr class="sum-row"><td>Summe</td><td class="r">66.300,00 €</td><td class="r">42.000,00 €</td><td class="r">18.500,00 €</td><td></td></tr></tbody></table></div><div class="page"><div class="appendix-header"></div><div class="appendix-title">Nachweisleistungen</div><div class="appendix-subtitle">Rechnung RE-2026-0042 &middot; Leistungsnachweis</div><table class="data-table"><thead><tr><th>Datum</th><th>Mitarbeiter</th><th class="r">Menge</th><th class="r">Einheitspreis</th><th class="r">Summe</th><th>Buchungstext</th></tr></thead><tbody><tr class="group-row"><td colspan="6">BL-2 &ndash; Besondere Leistungen nach Aufwand</td></tr><tr><td style="white-space:nowrap;">08.09.2026</td><td>Anna Muster</td><td class="r">3</td><td class="r">110,00 €</td><td class="r">330,00 €</td><td>Abstimmung Brandschutzkonzept</td></tr><tr><td style="white-space:nowrap;">15.09.2026</td><td>Ben Beispiel</td><td class="r">4.5</td><td class="r">95,00 €</td><td class="r">427,50 €</td><td>Bestandsaufnahme Untergeschoss</td></tr><tr class="subtotal-row"><td colspan="2">Zwischensumme</td><td class="r">7.5</td><td></td><td class="r">757,50 €</td><td></td></tr><tr class="sum-row"><td colspan="2">Gesamtsumme</td><td class="r">7.5</td><td></td><td class="r">757,50 €</td><td></td></tr></tbody></table></div><div class="page"><div class="appendix-header"></div><div class="appendix-title" style="font-size:14pt;">HOAI-Honorarübersicht</div><div class="appendix-subtitle"> K-01 – Objektplanung Gebäude &middot; P-2026-014 – Neubau Verwaltungsgebäude Nord &middot; Stand: 30.09.2026 </div><div class="section-title-h">Basisdaten</div><div class="basis-grid"><div class="basis-cell"><div class="bc-label">Honorarordnung</div><div class="bc-val">HOAI 2021 § 35</div></div><div class="basis-cell"><div class="bc-label">Honorarzone</div><div class="bc-val">III</div></div><div class="basis-cell"><div class="bc-label">Zonenanteil</div><div class="bc-val">50 %</div></div></div><table class="data-table" style="margin-top:3mm"><thead><tr><th style="width:12%">Kx</th><th class="num">Baukosten €</th><th class="num">Grundhonorar €</th></tr></thead><tbody><tr><td>K3</td><td class="num">2.400.000,00 €</td><td class="num">228.350,00 €</td></tr></tbody></table><div class="section-title-h">Leistungsphasen</div><table class="data-table"><thead><tr><th style="width:38%">Leistungsphase</th><th>Kx</th><th class="num">Basis €</th><th class="num">Basis %</th><th class="num">Basis-Honorar €</th><th class="num">Honorar %</th><th class="num">Honorar €</th></tr></thead><tbody><tr><td>LP2 – Vorplanung</td><td>K3</td><td class="num">228.350,00 €</td><td class="num">7</td><td class="num">15.984,50 €</td><td class="num">7</td><td class="num">15.984,50 €</td></tr><tr><td>LP3 – Entwurfsplanung</td><td>K3</td><td class="num">228.350,00 €</td><td class="num">15</td><td class="num">34.252,50 €</td><td class="num">15</td><td class="num">34.252,50 €</td></tr></tbody><tfoot><tr><td colspan="5">Grundhonorar</td><td></td><td class="num">50.237,00 €</td></tr></tfoot></table><div class="section-title-h">Besondere Leistungen</div><table class="data-table"><thead><tr><th style="width:12%">Kürzel</th><th style="width:45%">Bezeichnung</th><th>LPH-Bezug</th><th class="num">Betrag €</th></tr></thead><tbody><tr><td>BL-1</td><td>Bestandsaufnahme</td><td>LP1</td><td class="num">4.200,00 €</td></tr></tbody><tfoot><tr><td colspan="3">Summe Besondere Leistungen</td><td class="num">4.200,00 €</td></tr></tfoot></table><div class="section-title-h">Zuschläge &amp; Nachlässe</div><table class="data-table"><thead><tr><th style="width:45%">Bezeichnung</th><th class="num">%</th><th class="num">Basis €</th><th class="num">Betrag €</th></tr></thead><tbody><tr><td> Umbauzuschlag <div class="surcharge-detail">Basis: LP2–LP3</div></td><td class="num">20</td><td class="num">50.237,00 €</td><td class="num">10.047,40 €</td></tr><tr class="breakdown-row"><td colspan="4"><table class="breakdown-table"><thead><tr><th>Komponente</th><th style="text-align:right">Basis €</th><th style="text-align:right">Zuschlag €</th></tr></thead><tbody><tr class="bd-lph"><td>LP2</td><td class="bd-num">15.984,50 €</td><td class="bd-num">3.196,90 €</td></tr><tr class="bd-lph"><td>LP3</td><td class="bd-num">34.252,50 €</td><td class="bd-num">6.850,50 €</td></tr></tbody></table></td></tr></tbody><tfoot><tr><td colspan="3">Summe Zuschläge / Nachlässe</td><td class="num">10.047,40 €</td></tr></tfoot></table><div class="honorar-summary"><