exports[`Belegvorlagen — Ausgabe mit den Beispielbelegen invoice_korrektur 1`] = `"<!doctype html><html lang="de"><head><meta charset="utf-8"><style> * { box-sizing: border-box; margin: 0; padding: 0; } body { font-family: Arial, Helvetica, sans-serif; font-size: 10pt; color: #1a1a1a; line-height: 1.4; } /* ── Page breaks ─────────────────────────────────────── */ .page { page-break-after: always; } .page:last-child { page-break-after: auto; } .letter-header { page-break-inside: avoid; } .calc-table { page-break-inside: avoid; } .payment-note-row { page-break-inside: avoid; } /* ── Page 1 layout ───────────────────────────────────── */ .logo-area { display: flex; justify-content: flex-end; margin-bottom: 6mm; min-height: 4mm; } .logo-area img { max-height: 20mm; max-width: 70mm; object-fit: contain; } .sender-line { font-size: 7.5pt; color: #6b7280; border-bottom: 0.3pt solid #d1d5db; padding-bottom: 1mm; margin-bottom: 5mm; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; } /* DIN 676 letter layout: address window left, meta right */ .letter-header { display: flex; gap: 10mm; margin-bottom: 8mm; align-items: flex-start; } .address-col { width: 85mm; flex-shrink: 0; } .address-block { font-size: 10pt; line-height: 1.5; min-height: 35mm; } .address-block .name1 { font-weight: 600; } .meta-col { flex: 1; } .meta-table { width: 100%; border-collapse: collapse; font-size: 9pt; } .meta-table td { padding: 0.8mm 0; vertical-align: top; } .meta-table td.ml { color: #6b7280; width: 32mm; padding-right: 2mm; } .meta-table td.mv { font-weight: 500; } .meta-table td.mv.bold { font-weight: 700; } .meta-sep { border-top: 0.3pt solid #d1d5db; padding-top: 1.5mm; height: 3mm; } /* Reference / project line */ .ref-block { margin-bottom: 6mm; font-size: 9pt; color: #374151; display: flex; flex-wrap: wrap; gap: 0 8mm; } .ref-block .rf { display: flex; gap: 2mm; } .ref-block .rl { color: #6b7280; } /* Document title */ .doc-title { font-size: 14pt; font-weight: 700; margin-bottom: 5mm; color: #111827; } /* Free text blocks */ .text-block { font-size: 10pt; margin-bottom: 5mm; white-space: pre-line; line-height: 1.5; } /* Briefanrede über dem Kopftext */ .salutation { font-size: 10pt; margin-bottom: 3mm; line-height: 1.5; } /* ── Calculation table ───────────────────────────────── */ .calc-table { width: 100%; border-collapse: collapse; margin: 4mm 0 6mm 0; } .calc-table td { padding: 1.5mm 0; font-size: 10pt; vertical-align: baseline; } .calc-table td.label { color: #374151; } .calc-table td.amount { text-align: right; font-variant-numeric: tabular-nums; white-space: nowrap; padding-left: 6mm; } .calc-table tr.sub td { padding: 0.5mm 0; font-size: 8.5pt; color: #4b5563; } .calc-table tr.sub td.label { padding-left: 4mm; } .calc-table tr.sep td { padding: 0; height: 2mm; } .calc-table tr.sep td.line-cell { border-top: 0.5pt solid #9ca3af; } .calc-table tr.total-row td { font-weight: 700; font-size: 11pt; padding-top: 2mm; border-top: 1pt solid #1a1a1a; } .calc-table tr.due-row td { font-weight: 700; padding-top: 2mm; border-top: 0.5pt solid #9ca3af; } /* Payment note */ .payment-note-row { display: flex; align-items: flex-start; gap: 6mm; margin-top: 5mm; } .payment-note-text { flex: 1; } .payment-qr { flex: 0 0 auto; display: flex; flex-direction: column; align-items: center; } .payment-qr img { width: 28mm; height: 28mm; display: block; } .payment-qr-caption { font-size: 7pt; color: #6b7280; margin-top: 1mm; text-align: center; } .payment-note { font-size: 9.5pt; color: #374151; line-height: 1.5; } .payment-note strong { color: #1a1a1a; } /* ── Appendix pages ──────────────────────────────────── */ .appendix-header { display: flex; justify-content: flex-end; margin-bottom: 4mm; } .appendix-header img { max-height: 12mm; max-width: 50mm; object-fit: contain; } .appendix-title { font-size: 11pt; font-weight: 700; margin-bottom: 4mm; color: #111827; border-bottom: 0.5pt solid #d1d5db; padding-bottom: 1.5mm; } .appendix-subtitle { font-size: 9pt; color: #6b7280; margin-bottom: 3mm; } /* Generic appendix table */ .data-table { width: 100%; border-collapse: collapse; font-size: 9pt; } .data-table th { text-align: left; font-weight: 600; color: #374151; border-bottom: 0.5pt solid #9ca3af; padding: 1.5mm 2mm 1.5mm 0; } .data-table th.r, .data-table td.r { text-align: right; padding-left: 3mm; } .data-table td { padding: 1.5mm 2mm 1.5mm 0; border-bottom: 0.3pt solid #e5e7eb; vertical-align: top; } .data-table tr.sum-row td { font-weight: 700; border-top: 0.5pt solid #9ca3af; border-bottom: none; padding-top: 2mm; } /* Gruppierung nach Projektelement im Leistungsnachweis */ .data-table tr.group-row { break-after: avoid; } .data-table tr.group-row td { font-weight: 700; color: #111827; background: #f3f4f6; border-top: 0.8pt solid #9ca3af; border-bottom: 0.4pt solid #cbd5e1; padding: 2.2mm 2mm; } .data-table tbody tr.group-row:first-child td { border-top: none; } .data-table tr.subtotal-row td { font-weight: 600; color: #374151; border-top: 0.5pt solid #9ca3af; border-bottom: none; padding-top: 1.5mm; padding-bottom: 2.5mm; } .data-table .muted { color: #6b7280; font-size: 8.5pt; } .data-table .bold { font-weight: 600; } /* Footer is rendered by Playwright footerTemplate from __footerCols data */ body { padding-bottom: 4mm; } /* ── HOAI appendix – shared with honorar.njk ────────────── */ .basis-grid { display: grid; grid-template-columns: repeat(3,1fr); gap:3mm; margin-bottom:2mm; page-break-inside: avoid; } .basis-cell { padding:2mm 3mm; background:#f9fafb; border:0.3pt solid #e5e7eb; border-radius:2pt; } .basis-cell .bc-label { font-size:7.5pt; color:#6b7280; margin-bottom:0.5mm; } .basis-cell .bc-val { font-size:9.5pt; font-weight:600; } .section-title-h { font-size:9pt; font-weight:700; color:#374151; text-transform:uppercase; letter-spacing:0.03em; margin:6mm 0 2mm; padding-bottom:1mm; border-bottom:0.5pt solid #d1d5db; page-break-after: avoid; } .surcharge-detail { font-size:7.5pt; color:#6b7280; margin-top:0.5mm; } .breakdown-row td { background:#fafafa; border-bottom:0.3pt solid #e5e7eb; padding:1mm 2mm 1.5mm 8mm; } .breakdown-table { width:100%; border-collapse:collapse; font-size:7.5pt; } .breakdown-table th { font-size:6.5pt; color:#9ca3af; font-weight:600; padding:0 1mm 0.5mm; text-align:right; } .breakdown-table th:first-child { text-align:left; } .breakdown-table td { padding:0.4mm 1mm; } .breakdown-table td.bd-num { text-align:right; white-space:nowrap; width:22%; } .breakdown-table tr.bd-lph td, .breakdown-table tr.bd-bl td { color:#374151; } .surcharge-mode-badge { display:inline-block; font-size:6.5pt; padding:0 2mm; border-radius:2pt; background:#e0f2fe; color:#0369a1; font-weight:600; margin-left:1mm; vertical-align:middle; } .honorar-summary { margin-top:8mm; padding:4mm 5mm; background:#f0f9ff; border:0.5pt solid #bae6fd; border-radius:3pt; page-break-inside: avoid; } .honorar-summary table { width:100%; border-collapse:collapse; } .honorar-summary td { padding:1.2mm 0; font-size:9.5pt; } .honorar-summary td.sl { color:#374151; } .honorar-summary td.sv { text-align:right; font-weight:600; white-space:nowrap; } .honorar-summary tr.gesamthonorar td { font-size:12pt; font-weight:700; border-top:1pt solid #0284c7; padding-top:2mm; } table.data-table tfoot td { border-top:1pt solid #374151; border-bottom:none; font-weight:600; padding-top:2mm; } table.data-table tfoot tr.grand-total td { font-size:11pt; font-weight:700; color:#111827; padding-top:2mm; } table.data-table td.num { text-align:right; white-space:nowrap; } table.data-table th.num { text-align:right; } table.data-table { page-break-inside: auto; } table.data-table tbody tr { page-break-inside: avoid; } table.data-table thead { display: table-header-group; } </style><style> :root{ --brand-accent:#111827; --brand-font:Arial, Helvetica, sans-serif; } body{ font-family: var(--brand-font) !important; } .doc-title, .metaBlock .title{ color: var(--brand-accent) !important; } .logo-area{ justify-content: flex-end !important; } </style></head><body><div class="page"><div class="logo-area"></div><div class="sender-line"> Musterplanung GmbH &middot; Beispielstraße 1 &middot; 10115 Berlin </div><div class="letter-header"><div class="address-col"><div class="address-block"><div class="name1">Bauherr Beispiel AG</div><div>z. Hd. Frau Kerstin Ludwig</div><div>Musterallee 7</div><div>80331 München</div></div></div><div class="meta-col"><table class="meta-table"><tr><td class="ml">Kontakt</td><td class="mv">Dipl.-Ing. Anna Muster</td></tr><tr><td class="ml">Telefon</td><td class="mv">030 1234567</td></tr><tr><td class="ml">E-Mail</td><td class="mv">info@musterplanung.de</td></tr><tr><td class="meta-sep" colspan="2"></td></tr><tr><td class="ml">Datum</td><td class="mv">30.09.2026</td></tr><tr><td class="ml">Rechnungs-Nr.</td><td class="mv bold">RK-2026-0003</td></tr><tr><td class="ml">Zahlungsziel</td><td class="mv">30.10.2026</td></tr></table></div></div><div class="ref-block"><div class="rf"><span class="rl">Ihre Zeichen:</span><span>04011000-12345-34</span></div><div class="rf"><span class="rl">Bauvorhaben:</span><span>Verwaltungszentrum Nord</span></div><div class="rf"><span class="rl">Projekt:</span><span>P-2026-014 – Neubau Verwaltungsgebäude Nord</span></div><div class="rf"><span class="rl">Auftrag:</span><span>V-2026-003 – Generalplanervertrag</span></div><div class="rf"><span class="rl">Leistungszeitraum:</span><span>01.09.2026–30.09.2026</span></div></div><div class="doc-title">Rechnungskorrektur</div><div class="text-block">Korrektur zu Rechnung Nr. RE-2026-0042 vom 30.09.2026. Grund: Nebenkosten doppelt berechnet Die genannten Beträge mindern die ursprüngliche Rechnung.</div><div class="salutation">Sehr geehrte Frau Ludwig,</div><div class="text-block">vereinbarungsgemäß berechnen wir Ihnen unsere Leistungen für den Leistungszeitraum 01.09.2026–30.09.2026.</div><table class="calc-table"><tr><td class="label">erbrachtes Honorar</td><td class="amount">-1.000,00 €</td></tr><tr class="sep"><td class="line-cell"></td><td class="line-cell"></td></tr><tr><td class="label">zzgl. 19&#8239;% Mehrwertsteuer</td><td class="amount">-190,00 €</td></tr><tr class="total-row"><td class="label">Rechnungssumme</td><td class="amount">-1.190,00 €</td></tr></table></div></body></html>"`;

